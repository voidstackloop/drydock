{
  "name": "cpp-leakcheck",
  "version": "1.0.0",
  "description": "Leakcheck: find memory bugs, resource leaks and trojan behaviour in C/C++ programs. Prebuilt binaries plus a small Node API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/voidstackloop/drydock.git",
    "directory": "npm"
  },
  "homepage": "https://github.com/voidstackloop/drydock#readme",
  "bugs": "https://github.com/voidstackloop/drydock/issues",
  "keywords": ["c", "c++", "memory-leak", "sanitizer", "static-analysis", "malware", "valgrind"],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "leakcheck": "./bin/leakcheck.js"
  },
  "main": "./index.js",
  "files": [
    "bin/",
    "index.js",
    "install.js",
    "test/",
    "README.md"
  ],
  "scripts": {
